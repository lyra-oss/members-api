                <artifactId>gatling-maven-plugin</artifactId>
                <version>${gatling-maven-plugin.version}</version>
            </plugin>
            <plugin>
                <groupId>org.cyclonedx</groupId>
                <artifactId>cyclonedx-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>io.github.git-commit-id</groupId>
                <artifactId>git-commit-id-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>build-info</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <createdDate>now</createdDate>
                    <imageName>ghcr.io/lyra-oss/${project.artifactId}:${project.version}</imageName>
                    <image>
                        <builder>${buildpacks-builder.image}</builder>
                        <env>
                            <BP_OCI_SOURCE>https://github.com/lyra-oss/members-api</BP_OCI_SOURCE>
                            <BP_OCI_DESCRIPTION>Lyra OSS Members API</BP_OCI_DESCRIPTION>
                        </env>
                        <!-- Fixed volume names so build-code.yml and build-docker.yml can back them up and restore
                             them between CI runs, persisting the JDK/GraalVM layers Buildpacks caches here. -->
                        <buildCache>
                            <volume>
                                <name>members-api.build-cache</name>
                            </volume>
                        </buildCache>
                        <launchCache>
                            <volume>
                                <name>members-api.launch-cache</name>
                            </volume>
                        </launchCache>
                    </image>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <!-- Registers native-maven-plugin as a build extension so its GraalVM tracing-agent integration is
                     available on demand: "./mvnw -Dagent=true test" runs the test suite on a normal JVM with the
                     agent attached, which observes every reflection/resource/proxy access the app actually makes and
                     writes it to target/native/agent-output/ - a useful cross-check against the hand-maintained
                     registrars (HibernateRuntimeHints, ProtobufRuntimeHints), though not a substitute for them: it
                     only captures what the local test suite happens to exercise, not every boot-time path a real
                     deployment can still reach. -->
                <groupId>org.graalvm.buildtools</groupId>
                <artifactId>native-maven-plugin</artifactId>
                <extensions>true</extensions>
                <configuration>
                    <agent>
                        <enabled>${agent}</enabled>
                    </agent>
                </configuration>
            </plugin>
            <plugin>
                <!-- Every entity reached through a lazy association (e.g. PersonRole.person, @OneToOne(fetch =
                     LAZY)) needs a $HibernateProxy/$HibernateInstantiator subclass. Hibernate's default bytecode
                     provider (ByteBuddy) generates those the first time they're needed, at runtime - which
                     native-image's closed-world build can't accommodate, since no new bytecode can be generated
                     once the image is built. Bytecode enhancement performs that same generation at *compile* time
                     instead, baking the proxy/instantiator classes into target/classes as ordinary compiled
                     classes, so native-image's static analysis can see them like any other class; left
                     unregistered, creating an entity with such a lazy association (Teacher/Kid/Parent, via
                     PersonRole; but not School, which has none) fails with
                     BeanCreationException/NoSuchMethodException under native-image once that code path actually
                     runs.

                     Not org.hibernate.orm.tooling:hibernate-enhance-maven-plugin: that coordinate is Hibernate's
                     pre-7.0 Maven plugin, discontinued after 7.0.0.Beta1 in favor of this one
                     (org.hibernate.orm:hibernate-maven-plugin) - using the old, frozen-at-Beta1 coordinate against
                     this project's much newer hibernate-core breaks ~190 tests with AbstractMethodError. Pinning
                     this plugin's version to ${hibernate.version} keeps it locked to whatever hibernate-core
                     version Spring Boot's BOM manages. Binds by default to process-classes, right after "compile" -
                     before every later packaging step (spring-boot:process-aot, spring-boot:build-image) that
                     needs to see the enhanced classes. -->
