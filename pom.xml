                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <!-- The add-opens flag below: PerformanceSmokeIT embeds Gatling in-process (Gatling$.fromArgs),
                         which needs reflective access to java.lang for its stats writer. -->
                    <!--suppress UnresolvedMavenProperty -->
                    <argLine>@{argLine} -javaagent:${org.mockito:mockito-core:jar} --add-opens java.base/java.lang=ALL-UNNAMED</argLine>
                    <systemPropertyVariables>
