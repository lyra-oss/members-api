    <properties>
        <!-- Maven settings -->
        <java.version>25</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Which deliverable the *IT suite exercises: "jvm" packages target/*.jar into a plain JRE
             container; any other value is treated as an already-built OCI image reference. -->
        <it.image>jvm</it.image>
        <!-- How long SmokeSimulation ramps its (fixed) 3 users over, in seconds - see build-docker.yml's
             performance-test-duration-seconds input, which overrides this for a real run. -->
        <perf.smoke.durationSeconds>1</perf.smoke.durationSeconds>
        <!-- Off by default so an ordinary "mvn test" isn't instrumented; pass -Dagent=true to attach the
             GraalVM tracing agent to that test run instead (see the native-maven-plugin declaration below). -->
        <agent>false</agent>
        <!-- spring-boot:process-aot bakes @ConditionalOnProperty-gated bean *registrations* into the native image
             based on whatever the forked AOT JVM's own Environment sees - real deployments only ever set the real
             issuer-uri as an environment variable at container start, never at build time, so without this the
             JwtDecoder bean definition would be permanently stripped from the native image regardless of what's
             supplied later. This only has to satisfy that build-time condition: the generated bean-registration
             code still re-reads the property from the real Environment when the bean is actually created, so it
             never reaches this JVM, let alone a native-image-time HTTP call, and the real
             SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI override still takes effect as normal. Passed
             only to the forked AOT process (spring-boot-maven-plugin's own ${spring-boot.aot.jvmArguments} hook)
             rather than into application.properties, so it's never part of the shipped configuration. -->
        <spring-boot.aot.jvmArguments>-Dspring.security.oauth2.resourceserver.jwt.issuer-uri=https://placeholder.invalid/realms/members-api</spring-boot.aot.jvmArguments>
        <!-- Sonar settings -->
        <sonar.qualitygate.wait>true</sonar.qualitygate.wait>
        <sonar.coverage.exclusions>**/MembersApiApplication.java,**/*MapperImpl.java,**/ProtobufRuntimeHints.java,**/HibernateRuntimeHints.java,**/HibernateValidatorRuntimeHints.java</sonar.coverage.exclusions>
        <!-- Dependency versions -->
        <jackson-2-bom.version>2.22.3</jackson-2-bom.version>
        <jackson-bom.version>3.2.3</jackson-bom.version>
        <logback.version>1.6.3</logback.version>
        <tomcat.version>11.0.25</tomcat.version>
        <cucumber.version>7.34.8</cucumber.version>
        <okhttp.version>5.5.0</okhttp.version>
        <archunit.version>1.5.0</archunit.version>
        <instancio.version>6.0.1</instancio.version>
        <datafaker.version>2.7.0</datafaker.version>
        <mapstruct.version>1.6.3</mapstruct.version>
        <lombok-mapstruct-binding.version>0.2.0</lombok-mapstruct-binding.version>
        <springdoc-openapi.version>3.1.1</springdoc-openapi.version>
        <gatling.version>3.15.1</gatling.version>
        <!-- Buildpacks builder -->
        <!-- Pinned to a digest so every build of the same commit uses identical buildpack content; CI resolves this
             same property to key its build-cache/launch-cache backup, so a bump here is the only place that needs
             editing. Refresh with:
             docker buildx imagetools inspect paketobuildpacks/builder-noble-java-tiny:latest -->
        <buildpacks-builder.image>paketobuildpacks/builder-noble-java-tiny:latest@sha256:6553807caa811f6bb1f5bdd79318c56f275bc7da7e0d7ffc6470885c24919526</buildpacks-builder.image>
        <!-- Plugin versions -->
        <jacoco-maven-plugin.version>0.8.15</jacoco-maven-plugin.version>
        <snyk-maven-plugin.version>2.3.0</snyk-maven-plugin.version>
        <maven-surefire-plugin.version>3.5.5</maven-surefire-plugin.version>
        <maven-release-plugin.version>3.3.1</maven-release-plugin.version>
        <pitest-maven-plugin.version>1.30.0</pitest-maven-plugin.version>
        <gatling-maven-plugin.version>4.21.12</gatling-maven-plugin.version>
        <pitest-junit5-plugin.version>1.2.3</pitest-junit5-plugin.version>
        <rewrite-maven-plugin.version>6.46.1</rewrite-maven-plugin.version>
        <maven-checkstyle-plugin.version>3.6.0</maven-checkstyle-plugin.version>
        <checkstyle.version>14.1.0</checkstyle.version>
        <sonar-maven-plugin.version>5.8.0.7211</sonar-maven-plugin.version>
    </properties>

