{
  "mcpServers": {
    "codegraph": {
      "type": "stdio",
      "command": "codegraph",
      "args": [
        "serve",
        "--mcp"
      ]
    },
    "docker_desktop": {
      "command": "docker",
      "args": [
        "mcp",
        "gateway",
        "run",
        "--profile",
        "default"
      ]
    },
    "snyk": {
      "command": "snyk",
      "args": [
        "mcp",
        "-t",
        "stdio"
      ]
    }
  }
}
